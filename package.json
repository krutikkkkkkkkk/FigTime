{
  "name": "figtime",
  "version": "1.1.0",
  "description": "Discord Rich Presence for Figma — by Krutik",
  "main": "index.js",
  "type": "module",
  "author": "Krutik Raut",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "discord-rpc": "^4.0.1",
    "dotenv": "^18.0.9",
    "get-windows": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.infinitylinkage.figtime",
    "productName": "Figtime",
    "files": [
      "**/*",
      "!node_modules/.cache"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "get-windows@10.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
