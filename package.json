{
  "name": "figtime",
  "version": "1.1.0",
  "description": "Discord Rich Presence for Figma — by Krutik",
  "main": "index.js",
  "type": "module",
  "author": "Krutik Raut",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "discord-rpc": "^4.0.1",
    "dotenv": "^18.0.9",
    "get-windows": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.infinitylinkage.figtime",
    "productName": "Figtime",
    "files": [
      "index.js",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/get-windows/**"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "FigTime-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FigTime-${version}-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "get-windows@10.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
